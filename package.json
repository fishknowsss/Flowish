    "preview": "vite preview",
    "check": "npm run lint && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
