{
  "name": "flowish",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "open:local": "node scripts/open-local-site.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
